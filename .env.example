# # Local by default. Set TARGET_ENV explicitly for every remote target.
# BASE_URL=http://localhost:3000
# TARGET_ENV=local

# # Optional authenticated tests. Copy fixtures/sessions.example.json to the
# # ignored fixtures/sessions.json file and replace the examples with short-lived
# # synthetic-user sessions.
# SESSION_FILE=fixtures/sessions.json

# # Production requires this explicit acknowledgement. Heavy and write workloads
# # have additional safeguards documented in README.md.
# ALLOW_PRODUCTION_LOAD_TEST=false
# ALLOW_HEAVY_PRODUCTION_LOAD_TEST=false
# ALLOW_PRODUCTION_WRITES=false
# PRODUCTION_MAX_VUS=25
# ENABLE_STATEFUL_FLOWS=false
# STATEFUL_VUS=1

# # Grafana Cloud k6. Store real values in your shell or CI secrets, not this file.
# K6_CLOUD_TOKEN=
# K6_CLOUD_STACK_ID=
# K6_CLOUD_PROJECT_ID=

# Staging-only synthetic performance-user provisioning. Never point these at
# production. The hostname and Supabase project locks must match the URLs.
# PERF_ALLOWED_HOST=staging.example.com
# PERF_PRODUCTION_URL=https://www.example.com
# PERF_DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres
# PERF_DATABASE_SSL=true
# PERF_EXPECTED_DATABASE_HOST=pooler-host
# PERF_EXPECTED_DATABASE_PROJECT_REF=project-ref
# PERF_ALLOW_DATABASE_WRITE=false

# A staging-only Auth0 Management API application with read:users and create:users.
# PERF_AUTH0_DOMAIN=your-staging-tenant.eu.auth0.com
# PERF_AUTH0_MGMT_CLIENT_ID=
# PERF_AUTH0_MGMT_CLIENT_SECRET=
# PERF_AUTH0_CONNECTION=Username-Password-Authentication
# PERF_TEST_PASSWORD=

# Deterministic unique addresses. A plus alias such as yourname+perf is supported,
# producing yourname+perf-00001@gmail.com while all mail reaches one inbox.
# PERF_USER_COUNT=100
# PERF_EMAIL_DOMAIN=test.example.com
# PERF_EMAIL_PREFIX=perf-load
# PERF_SLUG_PREFIX=perf-load
# PERF_POOL_ID=default
# PERF_AUTH_CONCURRENCY=3
# PERF_USER_MANIFEST=fixtures/performance-users.json
# SESSION_FILE=fixtures/sessions.json
# REQUIRE_UNIQUE_SESSIONS=true

# Destructive cleanup is separately locked and requires Auth0 delete:users.
# PERF_ALLOW_ACCOUNT_DELETE=false
